{
  "theorem_1": {
    "statement": "P(x^3+ax^2+bx+c has 3 real roots), (a,b,c) iid U[-1,1]",
    "closed_form": "383/4860 + log(3)/48",
    "decimal_30dps": "0.101694340376058869599540860131",
    "cross_checks": {
      "quadrature_reduce_monic": "0.1016943403760587772697808 (agrees to ~1e-16, float-node limited)",
      "monte_carlo_2e8": "0.10172336 +- 2.31e-5 (+1.26 sigma)"
    }
  },
  "theorem_2": {
    "statement": "P(x^3+ax^2+bx+c has 3 real roots), (a,b,c) iid U[0,1]",
    "closed_form": "1/2880",
    "decimal_30dps": "0.000347222222222222222222222222222",
    "cross_checks": {
      "quadrature_reduce_monic": "0.0003472222222222 (agrees to ~1e-13)",
      "monte_carlo_2e8": "0.00034664 +- 1.30e-6 (-0.45 sigma)"
    }
  },
  "verified_steps": {
    "L1a_dchi_da": {
      "holds": true,
      "note": "dc_hi/da = -x_plus^2 <= 0"
    },
    "L1b_dchi_db": {
      "holds": true,
      "note": "dc_hi/db = -x_plus"
    },
    "L1b_xplus_positive_on_edge": {
      "holds": true,
      "note": "x_plus|_{a=-1} = (1+s)/3 > 0 for b <= 1/3"
    },
    "L1c_corner_value": {
      "holds": true,
      "note": "c_hi(-1,-1) = 1  (the extreme point; band touches but never crosses)"
    },
    "L1d_symmetry": {
      "holds": true,
      "note": "(a,b,c)->(-a,b,-c) preserves Disc; hence c_lo = -c_hi(-a,b) >= -1"
    },
    "T1_closed_form": {
      "holds": true,
      "note": "P_sym = 383/4860 + log(3)/48 (via asinh(1/sqrt(3)) = log(3)/2)"
    },
    "L2a_xplus_sign": {
      "holds": true,
      "note": "x_plus = (s-a)/3 <= 0 iff s <= a iff b >= 0"
    },
    "L2b_chi_on_bhi": {
      "holds": true,
      "note": "c_hi = a^3/27 <= 1/27 on b = a^2/3"
    },
    "L2b_chi_max_edge": {
      "holds": true,
      "note": "max c_hi on a=1 edge is 1/27 (increasing in b there)"
    },
    "L2c_clo_zero_curve": {
      "holds": true,
      "note": "c_lo = 0 and x_minus = -a/2 on b = a^2/4 (a >= 0)"
    },
    "L2c_dclo_db": {
      "holds": true,
      "note": "dc_lo/db = -x_minus >= 0 for a >= 0: single sign change at b = a^2/4"
    },
    "T2_inner_polynomial": {
      "holds": true,
      "note": "inner b-integral = a^5/480 (algebraic parts cancel to a rational)"
    },
    "T2_closed_form": {
      "holds": true,
      "note": "P_unit = 1/2880"
    }
  }
}